{% extends 'base.html.twig' %}

{% block title %}{{ tutorial.title }}{% endblock %}

{% block body %}
    <article class="mb-5">
        <h1>{{ tutorial.title }}</h1>
        <p class="text-muted">
            Par {{ tutorial.author.pseudonyme }} le {{ tutorial.createdAt|date('d/m/Y') }}
            · <a href="{{ path('app_category', {id: tutorial.category.id}) }}">{{ tutorial.category.name }}</a>
        </p>
        <div>{{ tutorial.content|nl2br }}</div>
        <p class="mt-3">
            {% for tag in tutorial.tags %}
                <a class="badge text-bg-secondary text-decoration-none" href="{{ path('app_tag', {id: tag.id}) }}">#{{ tag.name }}</a>
            {% endfor %}
        </p>
    </article>

    <section>
        <h2>Commentaires ({{ tutorial.comments|length }})</h2>

        {% for comment in tutorial.comments %}
            <div class="card mb-2">
                <div class="card-body">
                    <h6 class="card-subtitle text-muted mb-2">
                        {{ comment.author.pseudonyme }} · {{ comment.createdAt|date('d/m/Y H:i') }}
                    </h6>
                    <p class="card-text">{{ comment.content }}</p>
                </div>
            </div>
        {% else %}
            <p>Aucun commentaire pour le moment.</p>
        {% endfor %}

        <h3 class="mt-4">Ajouter un commentaire</h3>
        {% if commentForm %}
            {{ form_start(commentForm, {'attr': {'novalidate': 'novalidate'}}) }}
                {{ form_widget(commentForm) }}
                <button class="btn btn-primary mt-2">Commenter</button>
            {{ form_end(commentForm) }}
        {% else %}
            <p class="alert alert-info">
                <a href="{{ path('app_login') }}">Connectez-vous</a> pour commenter.
            </p>
        {% endif %}
    </section>
{% endblock %}