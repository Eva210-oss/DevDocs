{% extends 'base.html.twig' %}

{% block title %}{{ tutorial.title }} | DevDocs{% endblock %}

{% block body %}

<div class="container py-5">

    {# Retour #}
    <a href="{{ path('app_tutorials') }}" class="btn btn-outline-secondary mb-4">
        ← Back to Tutorials
    </a>

    {# Tutorial Header #}
    <div class="mb-4">
        <span class="badge bg-primary mb-2">
            {{ tutorial.category.name }}
        </span>

        <h1 class="fw-bold">{{ tutorial.title }}</h1>

        <p class="text-muted">
            By {{ tutorial.author.pseudonyme }}
            · {{ tutorial.createdAt|date('F d, Y') }}
        </p>

        {# Edit and Delete Buttons #}
        {% if app.user and app.user == tutorial.author %}

            <div class="mt-3 d-flex gap-2">

                <a href="{{ path('app_tutorial_edit', {'slug': tutorial.slug}) }}"
                   class="btn btn-warning btn-sm">
                    ✏️ Edit Tutorial
                </a>

                <form method="post"
                      action="{{ path('app_tutorial_delete', {'slug': tutorial.slug}) }}"
                      onsubmit="return confirm('Are you sure you want to delete this tutorial?');">

                    <input type="hidden"
                           name="_token"
                           value="{{ csrf_token('delete' ~ tutorial.id) }}">

                    <button class="btn btn-danger btn-sm">
                        🗑️ Delete Tutorial
                    </button>

                </form>

            </div>

        {% endif %}
    </div>

    {# Tags #}
    <div class="mb-4">
        {% for tag in tutorial.tags %}
            <span class="badge bg-light text-dark border me-1">
                #{{ tag.name }}
            </span>
        {% endfor %}
    </div>

    {# Tutorial Content #}
    <div class="card shadow-sm">
        <div class="card-body p-4 p-md-5">
            <div class="tutorial-content">
                {{ tutorial.content|raw }}
            </div>
        </div>
    </div>

    {# Comments Section #}
    <div class="mt-5">

        <h3 class="fw-bold mb-4">
            Comments ({{ tutorial.comments|length }})
        </h3>

        {# Flash Messages #}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message }}
            </div>
        {% endfor %}

        {# Add Comment Form #}
        {% if app.user %}

            <div class="card mb-4">
                <div class="card-body">

                    <h5 class="fw-bold mb-3">Leave a comment</h5>

                    {{ form_start(commentForm, {
                        'action': path('app_tutorial_comment', {'slug': tutorial.slug})
                    }) }}

                        {{ form_errors(commentForm) }}
                        {{ form_widget(commentForm.content) }}

                        <button type="submit" class="btn btn-primary mt-3">
                            💬 Post Comment
                        </button>

                    {{ form_end(commentForm) }}

                </div>
            </div>

        {% else %}

            <div class="alert alert-info">
                Please <a href="{{ path('app_login') }}">login</a> to leave a comment.
            </div>

        {% endif %}

        {# Existing Comments #}
        {% if tutorial.comments|length > 0 %}

            {% for comment in tutorial.comments %}

                <div class="card mb-3">
                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong>{{ comment.author.pseudonyme }}</strong>

                            <small class="text-muted">
                                {{ comment.createdAt|date('F d, Y') }}
                            </small>
                        </div>

                        <p class="mb-0">
                            {{ comment.content }}
                        </p>

                    </div>
                </div>

            {% endfor %}

        {% else %}

            <div class="alert alert-light border">
                No comments yet. Be the first to comment!
            </div>

        {% endif %}

    </div>

</div>

{% endblock %}